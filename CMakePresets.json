{
  "version": 3,
  "configurePresets": [
    {
      "name": "base-common",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_FEATURE_FLAGS": "manifests",
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/vcpkg/bincache,readwrite",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "windows-x64",
      "hidden": true,
      "inherits": "base-common",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-vs",
      "hidden": true,
      "inherits": "windows-x64",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "windows-vs2022-x64",
      "displayName": "Visual Studio 2022 x64 (Debug / Release)",
      "inherits": "windows-vs",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "windows-vs2026-x64",
      "displayName": "Visual Studio 2026 x64 (Debug / Release)",
      "inherits": "windows-vs",
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "linux-x64",
      "hidden": true,
      "inherits": "base-common",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "macos-x64",
      "hidden": true,
      "inherits": "base-common",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      }
    },
    {
      "name": "windows-x64-debug",
      "inherits": "windows-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-x64-release",
      "inherits": "windows-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-x64-debug",
      "inherits": "linux-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-x64-release",
      "inherits": "linux-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos-x64-debug",
      "inherits": "macos-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "macos-x64-release",
      "inherits": "macos-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-x64-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-x64-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-vs2022-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-vs2026-debug",
      "configurePreset": "windows-vs2026-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-vs2022-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-vs2026-debug",
      "configurePreset": "windows-vs2026-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026-x64",
      "configuration": "Release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-x64-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-x64-debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-x64-release"
    }
  ]
}
