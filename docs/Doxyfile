# Run from the repository root: doxygen docs/Doxyfile
DOXYFILE_ENCODING       = UTF-8
PROJECT_NAME           = "FuseVision"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "核心通用能力、深度学习数据与界面、传统视觉的接口与依赖"
OUTPUT_DIRECTORY       = out/docs/doxygen
OUTPUT_LANGUAGE        = Chinese
INPUT                  = src docs/doxygen/groups.dox
FILE_PATTERNS          = *.h *.cpp *.md *.dox
RECURSIVE              = YES
INPUT_ENCODING         = UTF-8
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCES_RELATION    = YES
REFERENCED_BY_RELATION = YES
GENERATE_TREEVIEW      = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_XML           = YES
XML_OUTPUT             = xml
GENERATE_LATEX         = NO
HAVE_DOT               = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = Q_OBJECT= Q_GADGET= Q_ENUM(x)= Q_FLAG(x)= Q_DECL_OVERRIDE=override Q_DECL_FINAL=final
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = out/docs/doxygen/warnings.log
